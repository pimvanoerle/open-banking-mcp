__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
# Every env file, not just ".env" -- .env.production holds a live client
# secret and this repo is public.
.env
.env.*
!.env.example
tokens.json
cache.db

# Editor debris. Vim names its swap file for ".env.production" as
# "..env.production.swp" -- the leading dot dodges the .env.* rule above,
# and a swap file holds the whole buffer, secret included.
*.swp
*.swo
*.swn
.*.sw[a-p]
*~
.netrwhist
.DS_Store
