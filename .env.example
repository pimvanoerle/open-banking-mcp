# Copy to .env (sandbox) or .env.production (live) and fill in.
# Get credentials from https://console.truelayer.com -- note the Sandbox/Live
# toggle: each environment has its own client id and its own secrets.
TRUELAYER_CLIENT_ID=sandbox-yourapp
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:8080/callback
TRUELAYER_ENV=sandbox

# Optional
# TRUELAYER_CACHE_FILE=~/.open-banking-mcp/cache.db
# TRUELAYER_MAX_AGE_HOURS=25
# TRUELAYER_HISTORY_DAYS=365
# TRUELAYER_PSU_IP=
